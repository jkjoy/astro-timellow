---
import { site } from '../data/site';
---

<section class="comments-section" id="comments">
  <h2 class="comments-header">
    <span class="comments-header-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"></path></svg>
    </span>
    <span>评论</span>
  </h2>
  <p class="twikoo-status" data-twikoo-status role="status">正在加载评论...</p>
  <div id="tcomment" class="twikoo-container" data-env-id={site.twikooEnvId}></div>
</section>

<script is:inline>
  (() => {
    const container = document.querySelector('#tcomment[data-env-id]');
    const status = document.querySelector('[data-twikoo-status]');

    if (!container || container.dataset.initialized === 'true') return;

    const setStatus = (message, isError = false) => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-error', isError);
      status.hidden = message === '';
    };

    const initialize = () => {
      if (!window.twikoo || typeof window.twikoo.init !== 'function') {
        setStatus('评论组件加载失败，请刷新页面重试。', true);
        return;
      }

      container.dataset.initialized = 'true';

      Promise.resolve(window.twikoo.init({
        envId: container.dataset.envId,
        el: '#tcomment',
        lang: 'zh-CN'
      })).then(() => {
        setStatus('');
      }).catch(() => {
        delete container.dataset.initialized;
        setStatus('评论服务暂时无法访问，请稍后再试。', true);
      });
    };

    if (window.twikoo) {
      initialize();
      return;
    }

    const existingScript = document.querySelector('script[data-twikoo-script]');

    if (existingScript) {
      existingScript.addEventListener('load', initialize, { once: true });
      existingScript.addEventListener('error', () => setStatus('评论组件加载失败，请刷新页面重试。', true), { once: true });
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/twikoo@1.6.44/dist/twikoo.nocss.js';
    script.async = true;
    script.dataset.twikooScript = 'true';
    script.addEventListener('load', initialize, { once: true });
    script.addEventListener('error', () => setStatus('评论组件加载失败，请刷新页面重试。', true), { once: true });
    document.head.appendChild(script);
  })();
</script>
