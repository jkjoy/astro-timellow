---
import { site } from '../data/site';
---

<nav class="sns-links" aria-label="站点链接">
  <a class="sns-link" href="/links/">友情链接</a>
  <a class="sns-link" href="/rss.xml">RSS</a>
  <a class="sns-link" href="/about/">关于本站</a>
</nav>
<footer class="site-footer">
  <p>&copy; {new Date().getFullYear()} <a href="/">{site.title}</a><span class="footer-divider">·</span><span>由 <a href="https://astro.build/" target="_blank" rel="noopener">Astro</a> 驱动</span><span class="footer-divider">·</span><span>Theme Timellow</span></p>
</footer>
<nav class="floating-actions" aria-label="快捷操作">
  <button class="floating-action floating-action-top" type="button" data-back-to-top hidden aria-label="返回顶部" title="返回顶部">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg>
  </button>
